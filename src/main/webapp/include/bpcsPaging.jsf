<table border="0" width="780" cellspacing="0" height="0%">
	<tr>
		<td width="0%"> 
			<span id="prevPageDiv">
				<nested:equal property="pagingFilter.dispPrevPage" value="true">
					<a href="javascript:checkFilterDirtyFlag(document.bpcsForm,'prevpage');" >
						<img src="images/btnPageLeft.png" border="0" alt="Previous Page" /></a>
				</nested:equal>
			</span>
		</td>
		<td nowrap width="1%">
			<div class="pagingInfo" id="pagingDiv">
				<nested:notEqual property="bpcsListSize" value="0">
					<nested:nest property="pagingFilter">
						<nested:hidden property="startRecord" />
						<nested:hidden property="recordsToRetrieve" />
						<nested:hidden property="totalRecordsInSet" />
						<nested:write property="startRecord" />-<nested:write property="endRecordForDisplay"/>/<nested:write property="totalRecordsInSet" /> 
					</nested:nest>
				</nested:notEqual>
			</div>
		</td>
		<td width="0%"> 
			<span id="nextPageDiv">
				<nested:equal property="pagingFilter.dispNextPage" value="true" >
					<a href="javascript:checkFilterDirtyFlag(document.bpcsForm,'nextpage');">
						<img src="images/btnPageRight.png" border="0" alt="Next Page" /></a>
				</nested:equal>
			</span>
		</td>
		<nested:nest property="pagingFilter">
		<td width="160">
		<div class="fltrTblHdng">
		Record&nbsp;#&nbsp;
		<nested:text property="recordNumberInSet" maxlength="7" styleClass="fltrWidth7"
		 onkeyup="return autoTab(this, 7, event);"  onchange="javascript:document.getElementById('pagingFilter.recordNumberInSet').value =(this.value);"/>
		</td>
		</div>
		</nested:nest>
		<td width="0%">
		<a href="javascript:changeCmdAndSubmit(document.bpcsForm,'selectedrecordpage');">
		<img src="images/btnGotoPage.png" border="0" alt="Goto Record"/></a>
		</td>
		<% 
				if ((TCGMUser.getRole().getAccessLevel()) != (Role.Query.getAccessLevel())) { %>
		<td class="right">
			<span id ="delSelDiv">
			<% //Sridevi.K 7-15-05 script changed to alert the user if he clicks deleteSelected without selecting any row%>
				<a href="javascript:doDelete(document.bpcsForm,'deleteselected','bpcsDelete.do');">
			<% //Sridevi.K 7-15-05 script changes end..%>
					<img src="images/btnDeleteSelected.png" border="0" alt="Delete Selected"/></a>
			</span>
			<span id ="delAllDiv">
			<% //Sridevi.K 7-15-05 script changed to alert the user if he clicks deleteall%>
				<a href="javascript:doDelete(document.bpcsForm,'deleteall','bpcsDelete.do');">
			<% //Sridevi.K 7-15-05 script changes end..%>
					<img src="images/btnDeleteAll.png" border="0" alt="Delete All" /></a>
			</span>
		</td>
		<td class="right">
			<span id = "saveDiv" class="hidden">
			<%//Sridevi.K 7-17-05 script changed to alert the user if he clicks saveSelected without selecting the records%>
				<a href="javascript:checkSave(document.bpcsForm,'saveselected','bpcsSave.do');">
			<%//Sridevi.K 7-17-05 end of script changes to alert the user%>
					<img src="images/btnSaveSelected.png" border="0" alt="Save Selected" /></a>
			</span>
			<span id = "cancelDiv" class="hidden">
				<a href="javascript:chgActCmdSubmit(document.bpcsForm,'cancel','bpcsMaint.do');">
					<img src="images/btnCancel.png" border="0" alt="Cancel Changes" /></a>
			</span>
		</td>
		<%}%>
	</tr>
</table>