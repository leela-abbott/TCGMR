<a name="top"></a>
<!-- Modernized Masthead Bar matching Application A styling parameters -->
<div style="width: 100%; background-color: #0000A0; padding: 15px 30px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; font-family: Arial, Helvetica, sans-serif; color: #FFFFFF; box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);">
    
    <!-- Left Segment: Context Dynamic Page Title -->
    <div style="font-size: 18pt; font-weight: bold; letter-spacing: 0.5px;">
        <%=pageTitle%>
    </div>
    
    <!-- Right Segment: Corporate App Context Subtitle -->
    <div style="font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; opacity: 0.85;">
        TCGM Enterprise Management Portal
    </div>

</div>

<!-- Structural Spacing Buffer replacing the old empty table row -->
<div style="margin-bottom: 20px;">&nbsp;</div>
