<%@ page import="abbott.ai.tcgm.action.form.AffBpcForm" %>
<table border="0" width="780" cellpadding="0" cellspacing="0" height="0%">
	<tr>
		<td class="fltrTblHdng">
			Copy to<br>
			Factor Model<br>
		</td>
		<td class="right">
			<span id="modelDsp">
				<nested:define id="factorModels" property="models" />
				<% // Sridevi.K 7-12-05:  Call the removeOptions script onfocus event. So, add this as attribute to the html select tag%>
				<html:select name="affBpcForm" property="modelSelected" size="1" >
				<%//Sridevi.K End .. %>
					<option value="none"><none></option>
					<html:options property="modelId" labelProperty="name" collection="factorModels" />
				</html:select>
			</span>
		</td>
		<td class="fltrTblHdng">
			Amount Type (C/P/*=both)<br>
		</td>
		<td>
			<select name="selAmountType">
				<option>C</option>
				<option>P</option>
				<option>*</option>
			</select>
		</td>
		<td class="fltrTblHdng">
			Update Option (Add/Chg)<br>
		</td>												
		<td>
			<select name="selUpdateType">
				<option>A</option>
				<option>C</option>
			</select>
		</td>
	</tr>
</table>
<table border="0" width="780" cellpadding="0" cellspacing="0" height="0%">
	<tr>			
		<td width="0%">
			<span id="prevPageDiv">				
					<nested:equal property="pagingFilter.dispPrevPage" value="true">
						<a href="javascript:checkFilterDirtyFlag(document.affBpcForm,'prevpage');" >
							<img src="images/btnPageLeft.png" border="0" alt="Previous Page" />
						</a>
					</nested:equal>
			</span>							
		</td>
		<td nowrap width="1%">
			<div class="pagingInfo" id="pagingDiv">
				<nested:notEqual property="affBpcListSize" value="0">
					<nested:nest property="pagingFilter">
						<nested:hidden property="startRecord" />
						<nested:hidden property="recordsToRetrieve" />
						<nested:hidden property="totalRecordsInSet" />
						<nested:write property="startRecord" />-<nested:write property="endRecordForDisplay"/>/<nested:write property="totalRecordsInSet" /> 
					</nested:nest>
				</nested:notEqual>
			</div>
		</td>
		<td width="0%">
			<span id="nextPageDiv">				
					<nested:equal property="pagingFilter.dispNextPage" value="true" >
						<a href="javascript:checkFilterDirtyFlag(document.affBpcForm,'nextpage');">
							<img src="images/btnPageRight.png" border="0" alt="Next Page" /></a>
					</nested:equal>
			</span>							
		</td>
		<nested:nest property="pagingFilter">
		<td width="160">
		<div class="fltrTblHdng">
		Record # 
		<nested:text property="recordNumberInSet" maxlength="7" styleClass="fltrWidth7"
		 onkeyup="return autoTab(this, 7, event);" />
		</td>
		</div>
		</nested:nest>
		<td width="0%">
		<a href="javascript:changeCmdAndSubmit(document.affBpcForm,'selectedrecordpage');">
		<img src="images/btnGotoPage.png" border="0" alt="Goto Record"/></a>
		</td>	
		
		<%//  Date Modified: 12/13/2005
		  //  Modified By  : Udaya B Aravapalli
		  //  The Initiate button was no longer required and such is being removed.%>
	 <td class="fltrTblHdng">
			Transmit<br>
			Aff<br>
		</td>
		<nested:define id="supAffList" property="supAffList" />
		<td class="right">
	    	  <html:select name="affBpcForm" property="supAffSelected" size="1" onchange='<%="javascript:setFilter();javascript:changeCmdAndSubmit(document.affBpcForm,\'filter\');" %>'>
				  <option value="ALL">ALL</option>
			  	<% String selected = null; 
			  	   for (int i=0; i<affBpcForm.getSupAffList().size(); i++) {
			  	   if ( (affBpcForm.getSupAffList().get(i)).equals(affBpcForm.getSupAffSelected())) selected = "Selected";
			  	%>
				  <option value="<%=affBpcForm.getSupAffList().get(i)%>" <%=selected%>><%=affBpcForm.getSupAffList().get(i)%></option>
				  <%  selected = null;} %>
			   </html:select>
	  </td>
		<td class="right">									
			<span id ="savSelDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'saveselected','affBpcSave.do');">
					<img src="images/btnCopySelected.png" border="0" alt="Copy Selected"/></a>
			</span>		
			<span id ="savAllDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'saveall','affBpcSave.do');">
					<img src="images/btnCopyAll.png" border="0" alt="Copy All" /></a>
			</span>
		</td>		
		<td class="right">									
			<span id ="delSelDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'deleteselected','affBpcDelete.do');">
					<img src="images/btnDeleteSelected.png" border="0" alt="Delete Selected"/></a>
			</span>					
			<span id ="delAllDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'deleteall','affBpcDelete.do');">
					<img src="images/btnDeleteAll.png" border="0" alt="Delete All" /></a>
			</span>
		</td>				
	</tr>			
</table>
	<script language="JavaScript1.2" type="text/javascript">
		function setFilter()
		{
 		  document.getElementById('searchObject.affiliateGroup').value = document.forms[0].supAffSelected.options[document.forms[0].supAffSelected.selectedIndex].value;
			if (document.getElementById('searchObject.affiliateGroup').value == "ALL")
			{
				document.getElementById('searchObject.affiliateGroup').value = "";
				document.getElementById('searchObject.cycleId').value="";
			}
			else
			{
				document.getElementById('searchObject.cycleId').value = document.getElementById('searchObject.affiliateGroup').value.substring(0,document.getElementById('searchObject.affiliateGroup').value.indexOf("::"));
				document.getElementById('searchObject.affiliateGroup').value = document.getElementById('searchObject.affiliateGroup').value.substring(document.getElementById('searchObject.affiliateGroup').value.indexOf("::")+2,document.getElementById('searchObject.affiliateGroup').value.lastIndexOf("::"))
			}
		}
	</script>
