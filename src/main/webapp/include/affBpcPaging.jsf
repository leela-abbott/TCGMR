
<%@ taglib prefix="s" uri="/struts-tags"%>
<!-- Model Selection and Options -->
<table border="0" width="780" cellpadding="0" cellspacing="0" height="0%">
	<tr>
		<td class="fltrTblHdng">
			Copy to<br>
			Factor Model<br>
		</td>
		<td class="right">
			<span id="modelDsp">
				<s:select name="modelSelected" 
						  size="1"
						  list="models" 
						  listKey="modelId" 
						  listValue="name"
						  headerKey="none" 
						  headerValue="<none>"
						  theme="simple" />
			</span>
		</td>
		<td class="fltrTblHdng">
			Amount Type (C/P/*=both)<br>
		</td>
		<td>
			<s:select name="selAmountType"
					  list="{'C','P','*'}"
					  theme="simple" />
		</td>
		<td class="fltrTblHdng">
			Update Option (Add/Chg)<br>
		</td>												
		<td>
			<s:select name="selUpdateType"
					  list="{'A','C'}"
					  theme="simple" />
		</td>
	</tr>
</table>
<!-- Pagination and Actions -->
<table border="0" width="780" cellpadding="0" cellspacing="0" height="0%">
	<tr>			
		<td width="0%">
			<span id="prevPageDiv">				
				<s:if test="pagingFilter.dispPrevPage == true">
					<a href="javascript:checkFilterDirtyFlag(document.affBpcForm,'prevpage');">
						<img src="images/btnPageLeft.png" border="0" alt="Previous Page" />
					</a>
				</s:if>
			</span>							
		</td>
		<td nowrap width="1%">
			<div class="pagingInfo" id="pagingDiv">
				<s:if test="affBpcListSize != 0">
					<s:hidden name="pagingFilter.startRecord" />
					<s:hidden name="pagingFilter.recordsToRetrieve" />
					<s:hidden name="pagingFilter.totalRecordsInSet" />
					<s:property value="pagingFilter.startRecord" />-<s:property value="pagingFilter.endRecordForDisplay"/>/<s:property value="pagingFilter.totalRecordsInSet" /> 
				</s:if>
			</div>
		</td>
		<td width="0%">
			<span id="nextPageDiv">				
				<s:if test="pagingFilter.dispNextPage == true">
					<a href="javascript:checkFilterDirtyFlag(document.affBpcForm,'nextpage');">
						<img src="images/btnPageRight.png" border="0" alt="Next Page" /></a>
				</s:if>
			</span>							
		</td>
		<td width="160">
			<div class="fltrTblHdng">
				Record # 
				<s:textfield name="pagingFilter.recordNumberInSet" 
							 maxlength="7" 
							 cssClass="fltrWidth7"
							 onkeyup="return autoTab(this, 7, event);"
							 theme="simple" />
			</div>
		</td>
		<td width="0%">
			<a href="javascript:changeCmdAndSubmit(document.affBpcForm,'selectedrecordpage');">
				<img src="images/btnGotoPage.png" border="0" alt="Goto Record"/></a>
		</td>	
		<td class="fltrTblHdng">
			Transmit<br>
			Aff<br>
		</td>
		<td class="right">
			<s:select name="supAffSelected" 
					  size="1"
					  list="supAffList"
					  headerKey="ALL" 
					  headerValue="ALL"
					  onchange="javascript:setFilter();javascript:changeCmdAndSubmit(document.affBpcForm,'filter');"
					  theme="simple" />
		</td>
		<td class="right">									
			<span id="savSelDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'saveselected','affBpcSave.do');">
					<img src="images/btnCopySelected.png" border="0" alt="Copy Selected"/></a>
			</span>		
			<span id="savAllDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'saveall','affBpcSave.do');">
					<img src="images/btnCopyAll.png" border="0" alt="Copy All" /></a>
			</span>
		</td>		
		<td class="right">									
			<span id="delSelDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'deleteselected','affBpcDelete.do');">
					<img src="images/btnDeleteSelected.png" border="0" alt="Delete Selected"/></a>
			</span>					
			<span id="delAllDiv">
				<a href="javascript:chgActCmdSubmit(document.affBpcForm,'deleteall','affBpcDelete.do');">
					<img src="images/btnDeleteAll.png" border="0" alt="Delete All" /></a>
			</span>
		</td>				
	</tr>			
</table>
<script language="JavaScript1.2" type="text/javascript">
	function setFilter() {
		var selectedValue = document.forms[0].supAffSelected.options[document.forms[0].supAffSelected.selectedIndex].value;
		document.getElementById('searchObject.affiliateGroup').value = selectedValue;
		if (document.getElementById('searchObject.affiliateGroup').value == "ALL") {
			document.getElementById('searchObject.affiliateGroup').value = "";
			document.getElementById('searchObject.cycleId').value = "";
		} else {
			var affGroup = document.getElementById('searchObject.affiliateGroup').value;
			document.getElementById('searchObject.cycleId').value = affGroup.substring(0, affGroup.indexOf("::"));
			document.getElementById('searchObject.affiliateGroup').value = affGroup.substring(affGroup.indexOf("::") + 2, affGroup.lastIndexOf("::"));
		}
	}
</script>