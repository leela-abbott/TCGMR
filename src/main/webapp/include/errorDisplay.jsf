<%-- Unified Struts 7 Error Display Fragment --%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<style type="text/css">
    /* Modern, clean container styling for Struts 7 framework errors */
    .rurd-error-container {
        width: 100%;
        box-sizing: border-box;
        margin-bottom: 15px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        text-align: left;
    }
    
    /* Targets the unordered lists automatically generated by Struts 7 tags */
    .rurd-error-container ul {
        list-style-type: none;
        margin: 0;
        padding: 10px 12px;
        background-color: #FFF0F0;
        border: 1px solid #FFC1C1;
        border-radius: 4px;
        color: #D8000C;
    }
    
    .rurd-error-container li {
        margin-bottom: 4px;
    }
    
    .rurd-error-container li:last-child {
        margin-bottom: 0;
    }
</style>

<!-- Struts 7 Error Check Block Component -->
<s:if test="hasActionErrors() || hasFieldErrors()">
    <div class="rurd-error-container">
        <%-- Renders global messages (e.g., Oracle login failures) --%>
        <s:actionerror theme="simple" />
        
        <%-- Renders input validation messages (e.g., missing fields) --%>
        <s:fielderror theme="simple" />
    </div>
</s:if>
