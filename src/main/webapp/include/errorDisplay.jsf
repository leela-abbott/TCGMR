<%-- Unified Struts 7 Error and Message Display Fragment --%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<style type="text/css">
    /* Constrained to match the 820px layout scheme of the main menu bar */
    .tcgm-error-container, .tcgm-message-container {
        width: 820px;
        box-sizing: border-box;
        margin: 15px auto 0 auto; /* Center alignment to match menu flow */
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        text-align: left;
    }
    
    /* Error styling for action/field errors */
    .tcgm-error-container ul {
        list-style-type: none;
        margin: 0;
        padding: 10px 12px;
        background-color: #FFF0F0;
        border: 1px solid #FFC1C1;
        border-radius: 4px;
        color: #D8000C;
    }
    
    /* Success/Informational styling for action messages - Darkened background and border */
    .tcgm-message-container ul {
        list-style-type: none;
        margin: 0;
        padding: 10px 12px;
        background-color: #D4EDDA; /* Richer, darker success green background */
        border: 1px solid #C3E6CB; /* Darker border to firmly ground the box layout */
        border-radius: 4px;
        color: #155724; /* Deep crisp green for high-contrast legibility */
        font-weight: 500;
    }

    
    .tcgm-error-container li, .tcgm-message-container li {
        margin-bottom: 4px;
    }
    
    .tcgm-error-container li:last-child, .tcgm-message-container li:last-child {
        margin-bottom: 0;
    }
    
        /* Fluid structure adapts automatically to narrow login frames or wide data page components */
    .tcgm-error-container, .tcgm-message-container {
        width: 100%;               /* Spans to match the exact width of its container card */
        max-width: 820px;          /* Prevents blowing past the main dashboard's 820px menu grid */
        box-sizing: border-box;
        margin: 15px auto 0 auto;  /* Maintains standard center positioning schemas */
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        text-align: left;
    }
    
</style>

<%-- Display Errors --%>
<s:if test="hasActionErrors() || hasFieldErrors()">
    <div class="tcgm-error-container">
        <s:actionerror theme="simple" escape="false" />
        <s:fielderror theme="simple" escape="false" />
    </div>
</s:if>

<%-- Display Success / Action Messages --%>
<s:if test="hasActionMessages()">
    <div class="tcgm-message-container">
        <s:actionmessage theme="simple" escape="false" />
    </div>
</s:if>
