
<%@ taglib prefix="s" uri="/struts-tags"%>
<jsp:useBean id="TCGMUser" scope="session" type="abbott.ai.tcgm.entities.User" />
<%-- <jsp:useBean id="Role" scope="application" class="abbott.ai.tcgm.entities.Role" /> --%>
<table border="0" width="780" cellspacing="0" height="0%">
	<tr>
		<td width="0%">&nbsp;
			<span id="prevPageDiv">
				<s:if test="pagingFilter.dispPrevPage == true">
					<a href="javascript:checkFilterDirtyFlag(document.asrForm,'prevpage');"> 
						<img src="images/btnPageLeft.png" border="0" alt="Previous Page" /></a>
				</s:if>
			</span>
		</td>
		<td nowrap width="1%">
			<div class="pagingInfo" id="pagingDiv">
				<s:if test="asrListSize != 0">
					<s:hidden name="pagingFilter.startRecord" />
					<s:hidden name="pagingFilter.recordsToRetrieve" />
					<s:hidden name="pagingFilter.totalRecordsInSet" />
					<s:property value="pagingFilter.startRecord" />-<s:property value="pagingFilter.endRecordForDisplay"/>/<s:property value="pagingFilter.totalRecordsInSet" />&nbsp;
				</s:if>
			</div>
		</td>
		<td width="0%">&nbsp;
			<span id="nextPageDiv">
				<s:if test="pagingFilter.dispNextPage == true">
					<a href="javascript:checkFilterDirtyFlag(document.asrForm,'nextpage');">
						<img src="images/btnPageRight.png" border="0" alt="Next Page" /></a>
				</s:if>
			</span>
		</td>
		<td width="160">
			<div class="fltrTblHdng">
				Record&nbsp;#&nbsp;
				<s:textfield name="pagingFilter.recordNumberInSet"
							 maxlength="7"
							 cssClass="fltrWidth7"
							 onkeyup="return autoTab(this, 7, event);"
							 onchange="document.getElementById('pagingFilter.recordNumberInSet').value = this.value;"
							 theme="simple" />	
			</div>
		</td>
		<td width="0%">
			<a href="javascript:changeCmdAndSubmit(document.asrForm,'selectedrecordpage');">
				<img src="images/btnGotoPage.png" border="0" alt="Goto Record"/></a>
		</td>
		<% if ((TCGMUser.getRole().getAccessLevel()) != (abbott.ai.tcgm.entities.Role.Query.getAccessLevel())) { %>
			<td class="right">
				<span id="delSelDiv">
					<a href="javascript:doDelete(document.asrForm,'deleteselected','asrDelete.do');">
						<img src="images/btnDeleteSelected.png" border="0" alt="Delete Selected"/></a>
				</span>
				<span id="delAllDiv">
					<a href="javascript:doDelete(document.asrForm,'deleteall','asrDelete.do');">
						<img src="images/btnDeleteAll.png" border="0" alt="Delete All" /></a>
				</span>
			</td>
			<td class="right">
				<span id="saveDiv" class="hidden">
					<a href="javascript:checkSave(document.asrForm,'saveselected','asrSave.do');">
						<img src="images/btnSaveSelected.png" border="0" alt="Save Selected" /></a>
				</span>
				<span id="cancelDiv" class="hidden">
					<a href="javascript:chgActCmdSubmit(document.asrForm,'cancel','asrMaintenance.action');">
						<img src="images/btnCancel.png" border="0" alt="Cancel Changes" /></a>
				</span>
			</td>
		<% } %>
	</tr>
</table>