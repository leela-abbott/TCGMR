<%@ taglib prefix="s" uri="/struts-tags"%>
<table border="0" width="300" cellpadding="0" cellspacing="0" height="0%">
    <br>
    <tr>
        <!-- Previous Page Button -->
        <td width="0%">&nbsp;
            <span id="prevPageDiv">
                <s:if test="pagingFilter.dispPrevPage == true">
                    <a href="javascript:checkFilterDirtyFlag(document.asrTranForm,'prevpage');">
                        <img src="images/btnPageLeft.png" border="0" alt="Previous Page" />
                    </a>
                </s:if>
            </span>
        </td>
        <!-- Record Counter Display -->
        <td nowrap width="1%">
            <div class="pagingInfo" id="pagingDiv">
                <s:if test="asrTranListSize != 0">
                    <%-- <s:hidden name="pagingFilter.startRecord" />
                    <s:hidden name="pagingFilter.recordsToRetrieve" />
                    <s:hidden name="pagingFilter.totalRecordsInSet" /> --%>
                    <s:property value="pagingFilter.startRecord" />-<s:property value="pagingFilter.endRecordForDisplay"/>/<s:property value="pagingFilter.totalRecordsInSet" />&nbsp;
                </s:if>
            </div>
        </td>
        
        <!-- Next Page Button -->
        <td width="0%">&nbsp;
            <span id="nextPageDiv">
                <s:if test="pagingFilter.dispNextPage == true">
                    <a href="javascript:checkFilterDirtyFlag(document.asrTranForm,'nextpage');">
                        <img src="images/btnPageRight.png" border="0" alt="Next Page" />
                    </a>
                </s:if>
            </span>
        </td>
        <!-- Goto Record Input -->
        <td width="160">
            <div class="fltrTblHdng">
                Record&nbsp;#&nbsp;
                <s:textfield name="pagingFilter.recordNumberInSet" 
                             maxlength="7" 
                             cssClass="fltrWidth7"
                             onkeyup="return autoTab(this, 7, event);" 
                             onchange="javascript:document.getElementById('pagingFilter.recordNumberInSet').value =(this.value);"
                             theme="simple" />
            </div>
        </td>
        <!-- Goto Page Button -->
        <td width="0%">
            <a href="javascript:changeCmdAndSubmit(document.asrTranForm,'selectedrecordpage');">
                <img src="images/btnGotoPage.png" border="0" alt="Goto Record"/></a>
        </td>
    </tr>
</table>