<%@ page errorPage="/jsp/exception.jsp" %>

<%-- Unified Struts 7 Tag Library Mapping (Replaces all 5 old Struts 1 taglibs) --%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<%-- Kept your custom Abbott library mapping intact --%>
<%@ taglib uri="/WEB-INF/taglib/abbott.tld" prefix="abbott" %>

<%-- Replaced legacy jsp:useBean scopes with clean expression variables --%>
<s:set var="TCGMConstants" value="#session['abbott.ai.tcgm.TCGMConstants']" scope="session" />
<s:set var="DBConst" value="#session['abbott.ai.tcgm.data.DBConst']" scope="session" />

<html>
    <head>
        <title>
            <%=pageTitle%>
        </title>
        <script language="JavaScript" src="include/common.js" type="text/javascript"></script>
        <link rel="stylesheet" type="text/css" href="include/master.css" title="Default">
        <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
    </head>
